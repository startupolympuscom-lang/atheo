# Neon-hosted Better Auth (Neon Auth). Set these in Vercel's project env
# vars — matching names, matching environments (Production/Preview) — and
# locally in .env.local (gitignored) for dev.
AUTH_URL=https://your-endpoint.neonauth.<region>.aws.neon.tech/<database>/auth
JWKS_URL=https://your-endpoint.neonauth.<region>.aws.neon.tech/<database>/auth/.well-known/jwks.json
